# TheCyberHub frontend environment variables.
# Copy to .env.local and adjust:  cp .env.example .env.local
# NEXT_PUBLIC_* values are baked in at build time: restart `npm run dev`
# (or rebuild) after changing them.

# --- Required -----------------------------------------------------------

# Backend API base URL (no trailing slash, no /api suffix).
# Default below uses the hosted dev API, so no local backend is needed.
NEXT_PUBLIC_API_URL=https://dev-api.thecyberhub.org

# Local backend (thecyberhub-core runs on port 5001 by default):
# NEXT_PUBLIC_API_URL=http://localhost:5001

# Public URL of this frontend (canonical links, SEO, OAuth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional -----------------------------------------------------------

# OAuth client IDs. Social login is disabled when these are empty.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Sentry error tracking. Disabled when empty.
NEXT_PUBLIC_SENTRY_DSN=

# Security tool backends. Each tool is disabled when its URL is empty.
NEXT_PUBLIC_HEADER_ANALYZER_API_URL=
NEXT_PUBLIC_SUBFINDER_API_URL=
NEXT_PUBLIC_SUB_TAKEOVER_API_URL=

# Extra origin allowed by the Content-Security-Policy connect-src
# (e.g. an AWS API Gateway URL used by a tool). See next.config.ts.
NEXT_PUBLIC_AWS_API_GATEWAY=
